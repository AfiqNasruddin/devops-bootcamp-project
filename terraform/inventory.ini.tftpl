[web]
webserver ansible_host=${webserver_ip}

[ctrl]
ctrl ansible_host=${ctrl_id} ansible_ssh_common_args='-o StrictHostKeyChecking=no -o ProxyCommand="aws ssm start-session --target %h --document-name AWS-StartSSHSession --parameters portNumber=%p --region ap-southeast-1"'

[mon]
mon ansible_host=${mon_ip}

[all:vars]
ansible_user=ubuntu
ansible_ssh_private_key_file=~/.ssh/id_ed25519
