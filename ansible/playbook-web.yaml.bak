---
- name: Webserver setup
  hosts: web
  become: true
  gather_facts: true
  tasks:
    - name: Update apt cache and upgrade packages
      ansible.builtin.apt:
        update_cache: true
        upgrade: dist
        cache_valid_time: 3600

    - name: Install prerequisites
      ansible.builtin.apt:
        name:
          - git
          - curl
          - python3
          - python3-pip
          - python3-venv
          - unzip
          - software-properties-common
          - zsh
        state: present

    - name: Set ubuntu login shell to zsh
      ansible.builtin.user:
        name: ubuntu
        shell: /usr/bin/zsh

    - name: Clone Oh My Zsh
      ansible.builtin.git:
        repo: https://github.com/ohmyzsh/ohmyzsh.git
        dest: /home/ubuntu/.oh-my-zsh
        version: master
      become_user: ubuntu

    - name: Install Oh My Zsh default zshrc
      ansible.builtin.copy:
        src: /home/ubuntu/.oh-my-zsh/templates/zshrc.zsh-template
        dest: /home/ubuntu/.zshrc
        remote_src: true
        force: false
        owner: ubuntu
        group: ubuntu
        mode: "0644"

    - name: Install Docker
      ansible.builtin.include_role:
        name: geerlingguy.docker
      vars:
        docker_users:
          - ubuntu

    - name: Wait for Docker socket
      ansible.builtin.wait_for:
        path: /var/run/docker.sock
        timeout: 90

    - name: Install AWS CLI v2
      ansible.builtin.shell: |
        set -euo pipefail
        curl -fsSL "https://awscli.amazonaws.com/awscli-exe-linux-x86_64.zip" -o /tmp/awscliv2.zip
        unzip -q -o /tmp/awscliv2.zip -d /tmp
        /tmp/aws/install
      args:
        creates: /usr/local/bin/aws

    - name: Clone Infratify/ship
      ansible.builtin.git:
        repo: https://github.com/Infratify/ship.git
        dest: /home/ubuntu/infratify-ship
        become_user: ubuntu

    - name: Install node_exporter
      ansible.builtin.include_role:
        name: prometheus.prometheus.node_exporter
      vars:
        node_exporter_web_listen_address: "0.0.0.0:9100"

    - name: Modify ship.config.json
      ansible.builtin.template:
        src: ship.config.json.j2
        dest: /home/ubuntu/infratify-ship/ship.config.json
        owner: ubuntu
        group: ubuntu
        mode: "0644"

    - name: Create Dockerfile for webserver
      ansible.builtin.copy:
        dest: /home/ubuntu/infratify-ship/Dockerfile
        mode: "0644"
        content: |
          FROM nginx:alpine
          COPY index.html /usr/share/nginx/html/
          EXPOSE 80
          CMD ["nginx","-g","daemon off;"]
      become_user: ubuntu
    
    - name: Create Docker image for webserver
      ansible.builtin.command:
        cmd: docker build -t ship:v1 .
        chdir: /home/ubuntu/infratify-ship

    - name: Check if the Docker image was created successfully
      ansible.builtin.command:
        cmd: docker images -q ship:v1
      register: docker_image
      changed_when: false

    - name: Fail if the Docker image was not created
      ansible.builtin.fail:
        msg: "Docker image 'ship:v1' was not created successfully."

    - name: If successful, push the Docker image to AWS ECR
      ansible.builtin.shell: |
        set -euo pipefail
        aws ecr get-login-password --region {{ aws_region }} | docker login --username AWS --password-stdin {{ ecr_repo }}
        docker tag ship:v1 {{ ecr_repo }}:{{ image_tag }}
        docker push {{ ecr_repo }}:{{ image_tag }}
      when: docker_image.stdout != ""
      